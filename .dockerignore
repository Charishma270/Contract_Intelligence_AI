# ==============================================================================
# Docker Build Context Exclusions
# ==============================================================================
# Day 22: Keeps the build context small and prevents sensitive/unnecessary
# files from being copied into the image.
# ==============================================================================

# --- Python caches ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# --- Version control ---
.git
.gitignore
.gitattributes

# --- Virtual environments ---
contract_ai_env/
.venv/
venv/

# --- Frontend (not needed in backend image) ---
frontend/

# --- Tests (not shipped in production) ---
tests/

# --- Notebooks ---
notebooks/
*.ipynb

# --- Sensitive / local files ---
.env
.env.*
!.env.example

# --- Pre-built vector store (volume-mounted in production) ---
data/vector_store/

# --- ML model weights (volume-mounted, not baked into image) ---
models/

# --- Build artifacts ---
dist/
build/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs (generated at runtime) ---
logs/

# --- Docker files (prevent recursive context) ---
docker-compose*.yml

# --- Documentation (not needed at runtime) ---
docs/
*.md
!README.md
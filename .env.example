# ==============================================================================
# Contract Intelligence AI — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults for local development.
#
# Day 20: Created as part of configuration externalization.
# ==============================================================================

# --- App Metadata -----------------------------------------------------------
APP_NAME=Contract Intelligence AI
APP_VERSION=0.6.0
APP_ENV=development
DEBUG=false

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins (* = all)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# --- File Upload -------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# --- Database (SQLite) -------------------------------------------------------
DATABASE_DIR=data
DATABASE_FILENAME=contracts.db

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILENAME=contract_ai.log
LOG_RETENTION_DAYS=30

# --- OCR (Tesseract + pdfplumber) --------------------------------------------
# Adjust these paths for your OS / installation
OCR_POPPLER_PATH=C:\poppler\poppler-26.02.0\Library\bin
OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_MIN_TEXT_LENGTH=50
OCR_CHUNK_SIZE=200
OCR_CHUNK_OVERLAP=50
OCR_DPI=300

# --- NLP (Legal-BERT + spaCy) ------------------------------------------------
NLP_MULTILABEL_MODEL_PATH=models/legal_bert_multilabel/trained_model
NLP_MULTILABEL_TOKENIZER_PATH=models/legal_bert_multilabel/tokenizer
NLP_LABEL_MAP_PATH=models/legal_bert_multilabel/label_mapping.json
NLP_CONFIDENCE_THRESHOLD=0.30
NLP_MAX_SEQUENCE_LENGTH=256
NLP_MAX_CHUNKS=50
NLP_SPACY_MODEL=en_core_web_sm

# --- Celery / Redis ----------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_RESULT_EXPIRES=86400

# --- Frontend / Docker -------------------------------------------------------
# Port where the frontend (nginx) is exposed on the host
FRONTEND_PORT=5173
